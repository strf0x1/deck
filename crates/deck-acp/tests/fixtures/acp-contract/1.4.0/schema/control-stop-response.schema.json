{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/control-stop-response.schema.json",
  "title": "Coordinator control `stop` reply (since 1.4.0)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "enum": [
        "created",
        "running",
        "stopped",
        "failed",
        "destroyed"
      ]
    }
  },
  "required": [
    "id",
    "state"
  ],
  "additionalProperties": true
}
