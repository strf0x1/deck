{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/control-task-request.schema.json",
  "title": "Coordinator control `task` request (since 1.4.0)",
  "type": "object",
  "properties": {
    "operation": {
      "const": "task"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "operation",
    "id"
  ],
  "additionalProperties": false
}
