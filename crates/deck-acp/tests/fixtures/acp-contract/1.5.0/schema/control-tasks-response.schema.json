{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/control-tasks-response.schema.json",
  "title": "Coordinator control `tasks` reply (since 1.4.0; `projects` since 1.5.0)",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://github.com/strf0x1/sprawlcommons-acp/schema/control-task-summary.schema.json"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "projects": {
      "description": "The coordinator's project set (since 1.5.0).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "tasks",
    "truncated",
    "projects"
  ],
  "additionalProperties": true
}
