{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/control-integration.schema.json",
  "title": "An integration worker's preparation and pins (since 1.6.0)",
  "type": "object",
  "properties": {
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,200}$"
    },
    "phase": {
      "enum": [
        "preparing",
        "waiting",
        "ready"
      ]
    },
    "base_commit": {
      "$ref": "#/$defs/commit"
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "commit": {
            "$ref": "#/$defs/commit"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "repository": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,200}$"
    }
  },
  "required": [
    "destination",
    "branch",
    "phase",
    "contributors"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "waiting"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ready"
          }
        }
      },
      "then": {
        "required": [
          "base_commit"
        ],
        "properties": {
          "contributors": {
            "items": {
              "required": [
                "commit"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "destination": {
            "properties": {
              "kind": {
                "enum": [
                  "new_pull_request",
                  "existing_pull_request"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "repository"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "destination": {
            "properties": {
              "kind": {
                "enum": [
                  "new_pull_request"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "base_branch"
        ]
      }
    }
  ],
  "$defs": {
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local_branch"
            },
            "branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]{1,200}$"
            }
          },
          "required": [
            "kind",
            "branch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "new_pull_request"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "existing_pull_request"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "number"
          ]
        }
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  }
}
